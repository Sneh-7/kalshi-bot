# kalshi-bot configuration. Copy to `.env` and fill in.
# `.env` is gitignored. NEVER commit real keys.

# ===== General =====
LOG_LEVEL=INFO
# SQLite is fine for local dev. Use Postgres for any multi-week / 24-7 run —
# ephemeral hosts wipe SQLite on restart and you lose the whole sample.
DATABASE_URL=sqlite:///./data/kalshi.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/kalshi

# ===== Agent loop =====
LOOP_INTERVAL_SECONDS=30
MIN_SIGNAL_CONFIDENCE=0.55
HEARTBEAT_MINUTES=30

# ===== Trading mode =====
# PAPER     = simulated fills, fees modeled (start here, ~1 week on DEMO)
# RECOMMEND = stage a bet and require Telegram approval before it goes live
# LIVE      = place real orders automatically (requires creds + explicit opt-in)
TRADING_MODE=PAPER

# ===== Kalshi Trade API v2 =====
# kalshi.com -> Profile -> API Keys. The private-key PEM is shown ONCE; store it
# outside the repo (secrets/ is gitignored).
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
# DEMO (default): https://external-api.demo.kalshi.co/trade-api/v2   (.co!)
# PROD:           https://external-api.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# ===== Risk (MODERATE) =====
BANKROLL_USD=1000
DEPLOYABLE_CAPITAL_USD=600
MAX_TRADE_FRACTION=0.05
KELLY_FRACTION=0.5
MAX_USD_PER_TRADE=30
MAX_OPEN_POSITIONS=8
DAILY_DRAWDOWN_USD=75
MIN_NET_EDGE=0.02

# ===== LLM Tier 1 (cheap sentiment classifier) =====
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== LLM Tier 2 (Claude analyst = the decision-maker) =====
ANALYST_ENABLED=true
ANALYST_MODEL=claude-opus-4-8
ANALYST_PROVIDER=claude
ANALYST_MAX_FINALISTS=8
ANALYST_EFFORT=high

# ===== Truth Social =====
TRUTH_SOCIAL_ENABLED=true
TRUTH_SOCIAL_USERNAME=realDonaldTrump
TRUTH_SOCIAL_PROVIDER=free
# Paid fallback (only if the free scrape breaks):
TRUTH_SOCIAL_API_URL=
TRUTH_SOCIAL_API_KEY=

# ===== Telegram (alerts + control) =====
# Create a bot with @BotFather -> token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Settlement =====
SETTLEMENT_ENABLED=true
