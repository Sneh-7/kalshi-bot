# =============================================================================
# kalshi-bot configuration.  Copy to `.env` and fill in:   cp example.env .env
# `.env` is gitignored. NEVER commit real keys.
#
# Each setting below has:  WHAT it does  and  HOW to get it (if it's a key).
#
# MINIMUM for the PAPER week (no real money, no Kalshi login needed):
#   - ANTHROPIC_API_KEY   (Claude makes the bet decisions)
#   - GROQ_API_KEY        (free fallback; optional but recommended)
#   - TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID  (alerts/control; optional)
# Kalshi API keys are only needed later, for real-money RECOMMEND/LIVE modes.
# =============================================================================


# ===== General ===============================================================

# WHAT: log verbosity. DEBUG for troubleshooting, INFO for normal runs.
LOG_LEVEL=INFO

# WHAT: where the audit trail (news, signals, trades, predictions) is stored.
# SQLite is fine locally. For a multi-week / 24-7 run use Postgres, because
# ephemeral hosts wipe SQLite on restart and you lose the whole sample.
# HOW (Postgres, optional): create a free DB at neon.tech or supabase.com and
# paste its connection string in the postgresql+psycopg2:// form below.
DATABASE_URL=sqlite:///./data/kalshi.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/kalshi


# ===== Agent loop ============================================================

# WHAT: seconds between each scan/decide cycle.
LOOP_INTERVAL_SECONDS=30
# WHAT: ignore news signals weaker than this (0-1) before they can trade.
MIN_SIGNAL_CONFIDENCE=0.55
# WHAT: alert over Telegram if a loop tick hasn't completed in this many minutes.
HEARTBEAT_MINUTES=30


# ===== Trading mode ==========================================================

# WHAT: how orders are handled.
#   PAPER     = simulated fills, fees modeled (START HERE, ~1 week on DEMO)
#   RECOMMEND = stage each bet and require Telegram approval before it goes live
#   LIVE      = place real orders automatically (requires creds + explicit opt-in)
TRADING_MODE=PAPER


# ===== Kalshi Trade API v2 (ONLY needed for real orders) =====================

# WHAT: authenticates order placement + balance/positions on Kalshi. Not needed
# for PAPER (market data is public). Two parts: a key ID and an RSA private key.
# HOW: log in at kalshi.com -> Profile/Settings -> API Keys -> "Create API Key".
# You get a Key ID (a UUID) and download a private-key .pem file ONCE (it is
# never shown again). Put the .pem in ./secrets/ (gitignored) and paste the ID.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# WHAT: which Kalshi environment to hit.
#   DEMO (default, play money): https://external-api.demo.kalshi.co/trade-api/v2   (.co!)
#   PROD (real money):          https://external-api.kalshi.com/trade-api/v2
# HOW: DEMO keys come from demo.kalshi.co; PROD keys from kalshi.com. They are
# different accounts — a demo key will NOT work against prod and vice versa.
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2


# ===== Risk (MODERATE profile) ===============================================
# WHAT: position sizing + safety limits. No keys — just numbers you choose.
BANKROLL_USD=1000              # total account size (reference)
DEPLOYABLE_CAPITAL_USD=600     # how much of it Kelly sizing is allowed to use
MAX_TRADE_FRACTION=0.05        # never stake >5% of deployable on one trade
KELLY_FRACTION=0.5             # half-Kelly safety multiplier
MAX_USD_PER_TRADE=30           # hard $ cap per trade
MAX_OPEN_POSITIONS=8           # max concurrent open positions
DAILY_DRAWDOWN_USD=75          # auto kill-switch if 24h P&L drops below -$75
MIN_NET_EDGE=0.02              # required edge AFTER fees+spread to trade


# ===== LLM Tier 1 — cheap sentiment classifier ===============================

# WHAT: GROQ runs the fast first-pass sentiment label on every headline, and is
# the fallback if Claude is unavailable. Free.
# HOW: sign up at console.groq.com -> "API Keys" -> Create API Key (free tier).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# WHAT: OPENAI is an optional secondary fallback classifier. Leave blank to skip.
# HOW: platform.openai.com -> API keys -> Create new secret key (paid).
OPENAI_API_KEY=

# WHAT: ANTHROPIC_API_KEY is the Anthropic API key. NOT required if you set
# ANALYST_PROVIDER=cli (the CLI uses your subscription instead). Needed if you
# use ANALYST_PROVIDER=claude, or want the optional Tier-1 Claude classifier.
# HOW: console.anthropic.com -> Settings -> API Keys -> Create Key. Add billing
# credit. The key starts with "sk-ant-".
ANTHROPIC_API_KEY=
# WHAT: cheap model used for Tier-1 labeling (keep as-is unless you know better).
ANTHROPIC_MODEL=claude-haiku-4-5


# ===== LLM Tier 2 — Claude analyst (the actual decision-maker) ===============
# WHAT: this stage is where Claude Opus prices each shortlisted market and decides
# side/size.
ANALYST_ENABLED=true
ANALYST_MODEL=claude-opus-4-8   # model id used by the API provider
ANALYST_MAX_FINALISTS=8         # how many markets reach Claude per tick (cost dial)
ANALYST_EFFORT=high             # low|medium|high|xhigh|max — more = deeper reasoning

# WHAT: which Claude engine makes the decisions.
#   cli    = run the Claude Code CLI on your SUBSCRIPTION (no API bill). Best on
#            your Mac. Bound by subscription usage limits; needs `claude` logged
#            in on whatever machine runs the bot. No ANTHROPIC_API_KEY required.
#   claude = call the Anthropic API (needs ANTHROPIC_API_KEY). Best for 24-7
#            servers: reliable, structured output, prompt caching (~$1-3/day).
#   groq   = use Groq as the primary decision-maker.
# Groq is always the fallback. Switch this per machine (cli on Mac, claude on VPS).
ANALYST_PROVIDER=cli

# --- CLI provider settings (only used when ANALYST_PROVIDER=cli) ---
# HOW: install Claude Code and log in once with your subscription:
#   npm install -g @anthropic-ai/claude-code   (or see claude.com/claude-code)
#   claude            # run once, choose "Log in with Claude account"
CLAUDE_CLI_PATH=claude          # path/name of the claude binary
ANALYST_CLI_MODEL=opus          # opus | sonnet | haiku (alias the CLI understands)
ANALYST_CLI_TIMEOUT=90          # seconds before a CLI decision is abandoned


# ===== Truth Social ==========================================================

# WHAT: pulls Trump's posts to inform "what will Trump say / mention" markets.
# "free" uses the public site (no key, no cost). Switch to "paid" only if the
# free scrape gets blocked.
TRUTH_SOCIAL_ENABLED=true
TRUTH_SOCIAL_USERNAME=realDonaldTrump
TRUTH_SOCIAL_PROVIDER=free
# WHAT/HOW (paid fallback, optional): a scraper API endpoint + key, e.g. from
# ScrapeCreators, Apify, or SocialCrawl. Sign up there, create an API key, and
# paste the request URL + token. Leave blank while PROVIDER=free.
TRUTH_SOCIAL_API_URL=
TRUTH_SOCIAL_API_KEY=


# ===== Telegram — alerts + control ===========================================

# WHAT: pushes trade cards to your phone and lets you Approve/Reject and run
# /status /pnl /calibration /positions /pause /resume /kill.
# HOW (token): open Telegram, message @BotFather, send /newbot, follow prompts,
# and it replies with a token like 123456789:ABC... -> paste it here.
TELEGRAM_BOT_TOKEN=
# HOW (chat id): message @userinfobot in Telegram; it replies with your numeric
# ID. Also send any message to YOUR new bot once so it's allowed to DM you.
TELEGRAM_CHAT_ID=


# ===== Settlement ============================================================

# WHAT: polls Kalshi for how markets actually resolved, settles positions, and
# scores Claude vs the market (Brier/log-loss) — the paper-week success gate.
SETTLEMENT_ENABLED=true


# ===== Browser fallback execution (optional, "Claude-in-Chrome") =============

# WHAT: a guarded backup that places an order through the Kalshi website when the
# API order path fails. Fragile — off by default, never the primary path.
# HOW: pip install playwright==1.48.0 && python -m playwright install chromium,
# then save a login session with:
#   python -m kalshi_bot.modules.browser_exec --login
# Keep DRY_RUN=true (it stops before clicking submit) until you've verified it.
BROWSER_EXEC_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_STORAGE_STATE_PATH=secrets/kalshi_storage_state.json
BROWSER_BASE_URL=https://kalshi.com
BROWSER_DRY_RUN=true
